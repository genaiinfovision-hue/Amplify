# Copy to .env.local for Vite. Firebase Storage = upload demo files only (no Firebase Auth). Store the returned URL in Supabase (submissions.video_url or assets.video_url).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: omit VITE_FIREBASE_AUTH_DOMAIN and the app will use {PROJECT_ID}.firebaseapp.com

# Supabase (catalog + Archeval assessment persistence)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Gemini (Archeval SLM vs LLM explanations)
VITE_GEMINI_API_KEY=

# Microsoft Entra ID (Azure AD) SSO for sign-in
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
# Optional — defaults to {origin}/login
# VITE_AZURE_REDIRECT_URI=

# Optional: separate Supabase project/table for ArchEval assessment history
# (standalone ArchEval used table `submissions`; embedded Amplify uses `archeval_submissions`)
# VITE_ARCHEVAL_SUPABASE_URL=
# VITE_ARCHEVAL_SUPABASE_KEY=
