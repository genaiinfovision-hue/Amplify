# Copy to .env.local for Vite.

# Supabase (required for auth + catalog + Archeval persistence)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=   # alternative to publishable key

# Firebase Storage = upload demo files only (no Firebase Auth). Store the returned URL in Supabase (submissions.video_url or assets.video_url).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: omit VITE_FIREBASE_AUTH_DOMAIN and the app will use {PROJECT_ID}.firebaseapp.com

# Google Gemini (Archeval SLM vs LLM explanations)
VITE_GEMINI_API_KEY=

# Optional: separate Supabase project/table for ArchEval assessment history
# VITE_ARCHEVAL_SUPABASE_URL=
# VITE_ARCHEVAL_SUPABASE_KEY=
# VITE_ARCHEVAL_TABLE=archeval_submissions
# VITE_ARCHEVAL_LEGACY_TABLE=submissions

# SSO setup (Supabase Dashboard + Microsoft Entra ID):
#
# STEP 1 — Microsoft Entra ID (Azure Portal)
#   1. Azure Portal → Microsoft Entra ID → App registrations → New registration
#   2. Name: AIMPLIFY
#   3. Supported account types: "Accounts in this organizational directory only" (single tenant)
#   4. Redirect URI — platform type **Web** (NOT Single-page application):
#      https://<YOUR-PROJECT-REF>.supabase.co/auth/v1/callback
#   5. Copy Application (client) ID
#   6. Certificates & secrets → New client secret → copy the **Value**
#
# STEP 2 — Supabase Dashboard
#   1. Authentication → Providers → Azure → Enable
#   2. Azure Client ID + Secret
#   3. Azure Tenant URL: https://login.microsoftonline.com/<YOUR-TENANT-ID>
#   4. Authentication → URL Configuration:
#      Site URL: https://<your-app>.vercel.app
#      Redirect URLs:
#        - http://localhost:5173/auth/callback
#        - https://<your-app>.vercel.app/auth/callback
#
# STEP 3 — Run supabase/migrations/20260617_auth_profiles_trigger.sql (optional, for SSO user profiles)
